{
  "name": "KoalaParty",
  "short_name": "KoalaParty",
  "description": "Watch YouTube together: synchronized playback, a shared queue and live chat.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0d1b15",
  "theme_color": "#0d1b15",
  "icons": [
    {
      "src": "/icons/koalaparty-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/koalaparty-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "id": "/",
  "scope": "/",
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "Create a room",
      "url": "/?create=1",
      "icons": [
        {
          "src": "/icons/koalaparty-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "My rooms",
      "url": "/rooms",
      "icons": [
        {
          "src": "/icons/koalaparty-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
